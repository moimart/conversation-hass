# vLLM tunables for llm/docker-compose.llm.yml. llm-control writes the real
# llm/llm.env (gitignored) from the HA entities; this file documents the keys.

# Model + the name OpenClaw and PAL address it by (vllm/<VLLM_SERVED_NAME>).
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
VLLM_SERVED_NAME=qwen3.8-27b

# Startup-fixed limits, driven by HA "LLM Context Size" / "LLM Concurrency".
VLLM_MAX_MODEL_LEN=131072
VLLM_MAX_NUM_SEQS=4

# Share of the WHOLE GPU vLLM may claim (weights + KV cache). The card also
# hosts STT, TTS and ComfyUI; Ollama's big models are unloaded while vLLM runs.
VLLM_GPU_MEM_UTIL=0.55

# Tool-call parser for Qwen3.8 (XML tool format). qwen3_coder is the fallback
# for older vLLM builds.
VLLM_TOOL_PARSER=qwen3_xml
