<?xml version="1.0" encoding="utf-8"?>
<!-- Voice notes widget (NotesWidgetProvider). Material You: wallpaper colours
     (values-v31/widget_colors.xml), system widget corner radii, tonal rows and a
     round tonal refresh button. The sample texts double as the picker preview;
     the provider replaces them on the first draw. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/notes_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_mic" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_notes_title"
            android:textColor="@color/widget_title"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/notes_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_meta"
            android:textSize="12sp"
            android:visibility="gone" />
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageButton
                android:id="@+id/notes_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_button"
                android:contentDescription="@string/widget_refresh"
                android:scaleType="center"
                android:src="@drawable/widget_ic_refresh" />
            <ProgressBar
                android:id="@+id/notes_progress"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/widget_title"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/notes_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/widget_meta"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/note_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="visible">
        <TextView
            android:id="@+id/note_text_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_sample_text_0"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/note_meta_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="@string/widget_sample_meta_0"
            android:textColor="@color/widget_meta"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/note_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="visible">
        <TextView
            android:id="@+id/note_text_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_sample_text_1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/note_meta_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="@string/widget_sample_meta_1"
            android:textColor="@color/widget_meta"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/note_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="visible">
        <TextView
            android:id="@+id/note_text_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_sample_text_2"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/note_meta_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="@string/widget_sample_meta_2"
            android:textColor="@color/widget_meta"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/note_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/note_text_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_sample_text_2"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/note_meta_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="@string/widget_sample_meta_2"
            android:textColor="@color/widget_meta"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/note_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/note_text_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_sample_text_2"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/note_meta_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="@string/widget_sample_meta_2"
            android:textColor="@color/widget_meta"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
