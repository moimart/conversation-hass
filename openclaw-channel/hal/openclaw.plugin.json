{
  "id": "hal",
  "kind": "channel",
  "channels": [
    "hal"
  ],
  "name": "PAL Kiosk",
  "description": "Channel plugin for the PAL voice assistant kiosk \u2014 routes voice commands through an OpenClaw agent and delivers responses back to the kiosk for TTS and display.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "hal": {
      "schema": {
        "type": "object",
        "properties": {
          "halBaseUrl": {
            "type": "string",
            "description": "PAL server base URL, e.g. http://your-pal-host:8765"
          },
          "halApiKey": {
            "type": "string",
            "description": "Optional shared secret for webhook authentication"
          },
          "dmPolicy": {
            "type": "string",
            "enum": [
              "open",
              "allowlist"
            ],
            "default": "open",
            "description": "DM security policy (open for LAN trust)"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowed sender IDs when dmPolicy is allowlist"
          }
        },
        "required": [
          "halBaseUrl"
        ]
      },
      "uiHints": {
        "halBaseUrl": {
          "label": "PAL Server URL"
        },
        "halApiKey": {
          "label": "API Key",
          "sensitive": true
        },
        "dmPolicy": {
          "label": "DM Policy"
        }
      }
    }
  }
}
